function updatePlacardSummaries(logs, subordinates) {
  let presentCount = 0;
  let absentCount = 0;
  let leaveCount = 0;
  let trainingCount = 0;

  subordinates.forEach(sub => {
    const status = logs[sub.idNumber]?.status || 'Present';
    
    // Group Late and Undertime into the active presence count
    if (status === 'Present' || status === 'Late' || status === 'Undertime') {
      presentCount++;
    } else if (status === 'Absent') {
      absentCount++;
    } else if (status === 'On Leave') {
      leaveCount++;
    } else if (status === 'On Training CPO') {
      trainingCount++;
    }
  });

  // Update your DOM placard elements
  document.getElementById('card-present').textContent = presentCount;
  document.getElementById('card-absent').textContent = absentCount;
  document.getElementById('card-leave').textContent = leaveCount;
  document.getElementById('card-training').textContent = trainingCount;
}

function refreshAttendanceChart(myChart, logs, subordinates) {
  let counts = { Present: 0, Absent: 0, Leave: 0, Training: 0 };

  subordinates.forEach(sub => {
    const status = logs[sub.idNumber]?.status || 'Present';

    if (status === 'Present' || status === 'Late' || status === 'Undertime') {
      counts.Present++;
    } else if (status === 'Absent') {
      counts.Absent++;
    } else if (status === 'On Leave') {
      counts.Leave++;
    } else if (status === 'On Training CPO') {
      counts.Training++;
    }
  });

  // Map aggregated totals to your Chart.js dataset structure
  myChart.data.datasets[0].data = [
    counts.Present, 
    counts.Absent, 
    counts.Leave, 
    counts.Training
  ];
  
  myChart.update();
}



