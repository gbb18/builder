    <!-- Attendance Summary Card with Integrated Mark Done / Completion Status -->
    <div class="glass-panel p-3 sm:p-5 rounded-2xl space-y-4">
      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 pb-3 border-b border-slate-300 dark:border-slate-700">
        <div>
          <div class="flex items-center gap-2 flex-wrap">
            <h2 class="text-xs sm:text-base font-extrabold dynamic-heading tracking-wide uppercase">Attendance Summary</h2>
            <div id="tlDoneStatusIndicatorContainer">
              <!-- Rendered dynamically inside header -->
            </div>
          </div>
          <p class="text-[11px] font-semibold dynamic-subtext">Tap badges to change status or add notes. Team leaders can mark attendance done here.</p>
        </div>
        
        <div class="flex flex-wrap items-center gap-2 w-full sm:w-auto justify-between sm:justify-end">
          <div class="hidden flex items-center gap-1 bg-slate-200/80 dark:bg-slate-800/80 p-1.5 rounded-xl border border-slate-300 dark:border-slate-700 text-[11px] font-bold overflow-x-auto max-w-full">
            <span class="px-1 dynamic-subtext flex items-center gap-1 shrink-0"><i class="fa-solid fa-filter text-[10px]"></i> View:</span>
