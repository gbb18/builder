/**
 * Shifts the currently selected date by a given number of days.
 * @param {number} days - Number of days to shift (positive for future, negative for past).
 */
window.shiftDate = async (days) => {
  const dateInput = document.getElementById('selectedDate');
  const currentDateVal = dateInput ? dateInput.value : window.state?.selectedDate;
  
  const currDate = currentDateVal ? new Date(currentDateVal) : new Date();
  currDate.setDate(currDate.getDate() + days);
  
  // Format back to YYYY-MM-DD safely
  const year = currDate.getFullYear();
  const month = String(currDate.getMonth() + 1).padStart(2, '0');
  const day = String(currDate.getDate()).padStart(2, '0');
  const newDateStr = `${year}-${month}-${day}`;
  
  if (dateInput) {
    dateInput.value = newDateStr;
  }
  
  if (typeof handleDateChange === 'function') {
    await handleDateChange();
  }
};


    



