        <div class="flex items-center space-x-3 overflow-hidden">
          <div class="w-10 h-10 rounded-2xl bg-gradient-to-tr from-emerald-600 to-teal-500 flex items-center justify-center text-white shadow-lg shadow-emerald-500/25 text-lg shrink-0">
            <i class="fa-solid fa-chart-line"></i>
          </div>
          <div class="truncate">
            <div class="flex items-center gap-2">
