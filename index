window.triggerBackendPinUpdate = async (oldPin, newPin) => {
  const errorDiv = document.getElementById('pinChangeError');
  const currentUser = window.state.currentUser;

  if (!currentUser) {
    if (errorDiv) {
      errorDiv.innerText = "No active user session found.";
      errorDiv.classList.remove('hidden');
    }
    return;
  }

  // 1. Verify old PIN matches current user's ID Number / PIN
  if (currentUser.idNumber !== oldPin) {
    if (errorDiv) {
      errorDiv.innerText = "Current PIN is incorrect.";
      errorDiv.classList.remove('hidden');
    }
    setTimeout(() => {
      resetPinWorkflow();
    }, 2000);
    return;
  }

  try {
    let updated = false;

    // 2. Update in local state teams or leadership
    if (currentUser.role === 'Team Leader' || currentUser.teamId) {
      const targetTeam = window.state.teams.find(t => t.id === currentUser.teamId);
      if (targetTeam) {
        targetTeam.idNumber = newPin;
        updated = true;
      }
    } else {
      // Check leadership categories
      Object.keys(window.state.leadership).forEach(cat => {
        const member = window.state.leadership[cat].find(m => m.id === currentUser.id || m.idNumber === oldPin);
        if (member) {
          member.idNumber = newPin;
          updated = true;
        }
      });
    }

    if (!updated) {
      throw new Error("User record not found in roster state.");
    }

    // 3. Save updated roster to Firebase Firestore
    if (isFirebaseReady) {
      await setDoc(doc(db, 'app_config', 'roster'), {
        teams: window.state.teams,
        leadership: window.state.leadership
      }, { merge: true });
    }

    // 4. Update current session in state and localStorage
    currentUser.idNumber = newPin;
    window.state.currentUser = currentUser;
    localStorage.setItem('bas_current_user', JSON.stringify(currentUser));

    alert("PIN successfully updated and saved to database!");
    closeChangePinModal();
    window.renderDashboard();

  } catch (error) {
    console.error("Error updating PIN in Firebase:", error);
    if (errorDiv) {
      errorDiv.innerText = "Failed to update PIN in database. Please try again.";
      errorDiv.classList.remove('hidden');
    }
    setTimeout(() => {
      resetPinWorkflow();
    }, 2000);
  }
};






