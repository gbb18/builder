// Helper to get date ranges based on selection
function getDateRangeForPeriod(period, referenceDateStr) {
  const refDate = new Date(referenceDateStr);
  const dates = [];
  
  if (period === 'weekly') {
    // Get Monday to Sunday of the reference date's week
    const day = refDate.getDay();
    const diffToMonday = refDate.getDate() - day + (day === 0 ? -6 : 1);
    const monday = new Date(refDate.setDate(diffToMonday));
    
    for (let i = 0; i < 7; i++) {
      const d = new Date(monday);
      d.setDate(monday.getDate() + i);
      dates.push(d.toISOString().split('T')[0]);
    }
  } else if (period === 'bi-monthly') {
    // 1st to 15th, or 16th to end of month
    const year = refDate.getFullYear();
    const month = refDate.getMonth();
    const day = refDate.getDate();
    
    const startDay = day <= 15 ? 1 : 16;
    const endDay = day <= 15 ? 15 : new Date(year, month + 1, 0).getDate();
    
    for (let d = startDay; d <= endDay; d++) {
      const dateObj = new Date(year, month, d);
      dates.push(dateObj.toISOString().split('T')[0]);
    }
  } else if (period === 'monthly') {
    // Full calendar month
    const year = refDate.getFullYear();
    const month = refDate.getMonth();
    const daysInMonth = new Date(year, month + 1, 0).getDate();
    
    for (let d = 1; d <= daysInMonth; d++) {
      const dateObj = new Date(year, month, d);
      dates.push(dateObj.toISOString().split('T')[0]);
    }
  }
  return dates;
}



