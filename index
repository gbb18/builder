              <span id="syncBadge" class="inline-flex items-center gap-1 text-[10px] font-bold px-1.5 py-0.5 rounded bg-emerald-500/15 text-emerald-600 dark:text-emerald-300 border border-emerald-500/30 shrink-0">
                <i class="fa-solid fa-cloud text-[8px]"></i> LIVE
              </span>
            </div>
            <p class="text-xs font-semibold dynamic-subtext truncate text-slate-500 dark:text-slate-400">Daily Attendance Tracker</p>
          </div>
        </div>
      </div> <!-- [FIXED]: Closed left branding container properly -->

      <!-- CENTER: Team Leader Profile & Live Digital Clock Display -->
      <div id="teamProfileCardContainer" class="w-full lg:w-auto flex items-center justify-center">
        <!-- Dynamically rendered via renderTeamHeader() -->
      </div>

      <!-- Right: Action Controls & User Badge -->
      <div class="flex items-center justify-center lg:justify-end gap-2 shrink-0 w-full lg:w-auto flex-wrap"> 
        
        <button id="refreshBtn" onclick="manualRefreshData()" class="p-2.5 rounded-xl text-xs bg-slate-200/90 dark:bg-slate-800 text-slate-800 dark:text-slate-100 border border-slate-300 dark:border-slate-700 hover:bg-slate-300 dark:hover:bg-slate-700 transition shadow-sm flex items-center justify-center" title="Refresh Data">
          <i id="refreshIcon" class="fa-solid fa-rotate text-emerald-500 text-xs"></i>
        </button>

        <button id="themeToggleBtn" onclick="toggleTheme()" class="p-2.5 rounded-xl text-xs bg-slate-200/90 dark:bg-slate-800 text-slate-800 dark:text-slate-100 border border-slate-300 dark:border-slate-700 hover:bg-slate-300 dark:hover:bg-slate-700 transition shadow-sm flex items-center justify-center" title="Toggle Theme">
          <i id="themeToggleIcon" class="fa-solid fa-moon text-amber-400 text-xs"></i>
        </button>

        <button onclick="openChangePinModal()" class="p-2.5 rounded-xl text-xs bg-slate-200/90 dark:bg-slate-800 text-slate-800 dark:text-slate-100 border border-slate-300 dark:border-slate-700 hover:bg-slate-300 dark:hover:bg-slate-700 transition shadow-sm flex items-center justify-center" title="Change PIN">
          <i class="fa-solid fa-key text-[11px] text-amber-500"></i>
          <!-- [FIXED]: Removed empty redundant span element -->
        </button>

        <button id="adminRosterBtn" onclick="openTeamManagerModal()" class="px-3 py-2 rounded-xl text-xs font-semibold bg-amber-500/20 hover:bg-amber-500/30 text-amber-600 dark:text-amber-300 border border-amber-500/40 transition hidden items-center gap-1.5 shadow-sm" title="Manage Roster (Admin Only)">
          <i class="fa-solid fa-users-gear text-[11px]"></i>
          <span class="text-[11px] hidden sm:inline">Roster</span>
        </button>

        <button id="authBtn" onclick="openLoginModal()" class="px-3.5 py-2 rounded-xl text-xs font-bold bg-emerald-600 hover:bg-emerald-500 text-white transition flex items-center gap-1.5 shadow-md">
          <i class="fa-solid fa-right-to-bracket text-[11px]"></i>
          <span id="authBtnText">Login</span>
        </button>
      </div>

  </div>
</header>


  </header>

  <!-- Screenshot View Section -->
