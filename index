    else if (r.status === 'On Training CPO') badgeClass = 'bg-purple-500/20 text-purple-700 dark:text-purple-300 border-purple-500/40';
    else if (r.status === 'Absent') badgeClass = 'bg-rose-500/20 text-rose-700 dark:text-rose-300 border-rose-500/40';

    tbody.innerHTML += `
