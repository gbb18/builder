            <span class="text-xs font-black text-emerald-700 dark:text-emerald-300" id="scRatio">0/0 Present</span>
          </div>
        </div>
      </div>
      <div id="scAttendanceCardsContainer" class="grid grid-cols-1 gap-3"></div>

      <div class="pt-3 border-t border-slate-300 dark:border-slate-700">
