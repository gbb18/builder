            <i id="claimsEyeIcon" class="fa-solid fa-eye text-emerald-500"></i>
          </button>
        </div>
      </div>

      <div id="claimsCardBodyContent" class="hidden overflow-x-auto rounded-xl border border-slate-300 dark:border-slate-700">
