    <!-- SEPARATED CLAIMS MANAGEMENT SECTION & WIDGETS -->
    <div class="glass-panel p-3 sm:p-5 rounded-2xl space-y-4 border-2 border-amber-500/30">
      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 pb-3 border-b border-slate-300 dark:border-slate-700">
        <div>
          <h2 class="text-xs sm:text-base font-extrabold dynamic-heading tracking-wide uppercase flex items-center gap-2">
            <i class="fa-solid fa-file-invoice-dollar text-amber-500"></i> Team Claims Consolidation
          </h2>
          <p class="text-[11px] font-semibold dynamic-subtext">Consolidate team claims and overall total claims.</p>
        </div>
        
        <div class="flex flex-wrap items-center gap-2 w-full sm:w-auto justify-between sm:justify-end">
          <div class="bg-amber-500/10 dark:bg-amber-500/15 border border-amber-500/40 px-3 py-1.5 rounded-xl flex items-center gap-2 shadow-sm">
            <span class="text-[11px] font-extrabold text-amber-700 dark:text-amber-300 uppercase">Team Claims Total:</span>
            <span id="teamClaimsTotalDisplay" class="text-sm font-black text-amber-600 dark:text-amber-400 font-mono">0</span>
          </div>
          <div class="bg-purple-500/10 dark:bg-purple-500/15 border border-purple-500/40 px-3 py-1.5 rounded-xl flex items-center gap-2 shadow-sm">
            <span class="text-[11px] font-extrabold text-purple-700 dark:text-purple-300 uppercase">Overall Adjudicator Total Claims:</span>
            <span id="overallClaimsTotalDisplay" class="text-sm font-black text-purple-600 dark:text-purple-400 font-mono">0</span>
          </div>
