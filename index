      const logs = window.state.dailyLogs[dateKey] || {};
      const remarksVal = window.state.summaryRemarks[dateKey] || '';
      
      const mainSummaryInput = document.getElementById('mainSummaryRemarksInput');
      if (mainSummaryInput && mainSummaryInput.value !== remarksVal) {
        mainSummaryInput.value = remarksVal;
      }

      // Render Attendance Summary Placards
      const subordinates = activeTeam ? activeTeam.subordinates : [];
      const grouped = { 'Present': [], 'On Leave': [], 'On Training CPO': [], 'Late': [], 'Undertime': [], 'Absent': [] };
      let presentCount = 0;

      subordinates.forEach(sub => {
        const status = (logs[sub.idNumber] && logs[sub.idNumber].status) ? logs[sub.idNumber].status : 'Present';
        if (!grouped[status]) grouped[status] = [];
        grouped[status].push(sub);
        if (status === 'Present' || status === 'On Training CPO' || status === 'Late' || status === 'Undertime') presentCount++;
      });

      document.getElementById('attendanceCountSummary').textContent = `${presentCount}/${subordinates.length}`;

      const cardConfigs = [
        { key: 'Present', title: 'PRESENT', icon: 'fa-user-check', border: 'border-emerald-500/50', textColor: 'text-emerald-600 dark:text-emerald-400', badgeBg: 'bg-emerald-100 dark:bg-emerald-950/85 text-emerald-900 dark:text-emerald-100 border-emerald-500' },
        { key: 'On Leave', title: 'ON LEAVE', icon: 'fa-umbrella-beach', border: 'border-indigo-500/50', textColor: 'text-indigo-600 dark:text-indigo-400', badgeBg: 'bg-indigo-100 dark:bg-indigo-950/85 text-indigo-900 dark:text-indigo-100 border-indigo-500' },
        { key: 'On Training CPO', title: 'TRAINING/SEMINAR (CPO)', icon: 'fa-graduation-cap', border: 'border-purple-500/50', textColor: 'text-purple-600 dark:text-purple-400', badgeBg: 'bg-purple-100 dark:bg-purple-950/85 text-purple-900 dark:text-purple-100 border-purple-500' },
        { key: 'Late', title: 'LATE', icon: 'fa-clock', border: 'border-amber-500/50', textColor: 'text-amber-600 dark:text-amber-400', badgeBg: 'bg-amber-100 dark:bg-amber-950/85 text-amber-900 dark:text-amber-100 border-amber-500' },
        { key: 'Undertime', title: 'UNDERTIME', icon: 'fa-business-time', border: 'border-teal-500/50', textColor: 'text-teal-600 dark:text-teal-400', badgeBg: 'bg-teal-100 dark:bg-teal-950/85 text-teal-900 dark:text-teal-100 border-teal-500' },
        { key: 'Absent', title: 'ABSENT', icon: 'fa-user-xmark', border: 'border-rose-500/50', textColor: 'text-rose-600 dark:text-rose-400', badgeBg: 'bg-rose-100 dark:bg-rose-950/85 text-rose-900 dark:text-rose-100 border-rose-500' }
      ];

      const container = document.getElementById('attendanceCardsContainer');
      if (container) {
        container.innerHTML = '';
        cardConfigs.forEach(cfg => {
          const members = grouped[cfg.key] || [];
          if (members.length === 0) return;

          const count = members.length;
          const badges = members.map(m => {
            const logItem = logs[m.idNumber] || {};
            const noteText = logItem.note ? ` <span class="opacity-80 italic text-[10px]">(${logItem.note})</span>` : '';
            return `
              <div onclick="openStatusPicker('${m.idNumber}', '${m.name.replace(/'/g, "\\'")}')" class="px-3 py-1.5 rounded-full text-xs border ${cfg.badgeBg} flex items-center justify-between cursor-pointer hover:opacity-80 transition shadow-sm">
                <span class="font-bold">${m.name}${noteText}</span>
                <span class="text-[10px] font-mono opacity-70">${m.idNumber}</span>
              </div>
            `;
          }).join('');

          container.innerHTML += `
            <div class="p-4 rounded-2xl border ${cfg.border} bg-slate-200/50 dark:bg-slate-800/80 space-y-3 shadow-md">
              <div class="flex items-center justify-between">
                <span class="text-xs font-black uppercase tracking-wider ${cfg.textColor} flex items-center gap-1.5">
                  <i class="fa-solid ${cfg.icon}"></i> ${cfg.title}
                </span>
                <span class="text-sm font-black dynamic-heading bg-slate-300/60 dark:bg-slate-700/60 px-2 py-0.5 rounded-lg">${count}</span>
              </div>
              <div class="flex flex-col gap-2 pt-1">${badges}</div>
            </div>
          `;
        });
      }
	
	// Run this when your DOM is fully loaded or during app initialization
document.addEventListener('DOMContentLoaded', () => {
  const dateInput = document.getElementById('selectedDate');
  if (dateInput) {
    dateInput.value = window.state.selectedDate;
  }

  const displayEl = document.getElementById('clockDateDisplay');
  if (displayEl) {
    displayEl.textContent = window.state.selectedDate;
  }
});


      // Render TL Done Indicator Badge in Summary Header
      const tlDoneMap = window.state.tlDoneStatus[dateKey] || {};
      const isDone = activeTeam ? !!tlDoneMap[activeTeam.id] : false;
      const doneContainer = document.getElementById('tlDoneStatusIndicatorContainer');
      if (doneContainer && activeTeam) {
        doneContainer.innerHTML = `
          <button onclick="toggleTLDoneStatus('${activeTeam.id}')" class="px-2.5 py-1 rounded-xl text-[11px] font-extrabold border transition flex items-center gap-1.5 ${isDone ? 'bg-emerald-500/20 text-emerald-600 dark:text-emerald-300 border-emerald-500/50' : 'bg-slate-200 dark:bg-slate-800 text-slate-600 dark:text-slate-400 border-slate-300 dark:border-slate-700'}">
            <i class="fa-solid ${isDone ? 'fa-circle-check text-emerald-500' : 'fa-circle'}"></i>
            <span>${isDone ? 'Attendance Marked Done' : 'Mark Attendance Done'}</span>
          </button>
        `;
      }


      // Render Claims Table & Totals
      const claimsTableBody = document.getElementById('claimsTableBody');
      if (claimsTableBody && activeTeam) {
        claimsTableBody.innerHTML = '';
        let teamClaimsSum = 0;
        let overallClaimsSum = 0;

        // Calculate overall claims across all teams
        window.state.teams.forEach(t => {
          t.subordinates.forEach(s => {
            overallClaimsSum += (window.state.claims[s.idNumber] || 0);
          });
        });

        activeTeam.subordinates.forEach(sub => {
          const subClaims = window.state.claims[sub.idNumber] || 0;
          teamClaimsSum += subClaims;
          claimsTableBody.innerHTML += `
            <tr class="hover:bg-slate-200/60 dark:hover:bg-slate-800/60">
              <td class="p-3 font-mono text-emerald-600 dark:text-emerald-400">${sub.idNumber}</td>
              <td class="p-3 font-bold">${sub.name}</td>
              <td class="p-3 text-center">
                <input type="number" min="0" value="${subClaims}" onchange="updateSubordinateClaims('${sub.idNumber}', this.value)" class="w-20 text-center dynamic-input border rounded-lg px-2 py-1 text-xs font-mono font-bold">
              </td>
            </tr>
          `;
        });

        document.getElementById('teamClaimsTotalDisplay').textContent = teamClaimsSum;
        document.getElementById('overallClaimsTotalDisplay').textContent = overallClaimsSum;
      }

      renderCharts();
    };

    window.addEventListener('DOMContentLoaded', async () => {
      document.getElementById('selectedDate').value = window.state.selectedDate;
      window.applyTheme();
      startLiveHeaderClock();
      await bootstrapFirestoreData();
      
      // Prompt login modal by default if not authenticated
      if (!window.state.currentUser) {
        window.openLoginModal();
      }
 })

window.startInlineEditRoster = (rowKey) => {
      window.state.editingRowKey = rowKey;
      window.renderRosterTable();
    };

    window.cancelInlineEditRoster = () => {
      window.state.editingRowKey = null;
      window.renderRosterTable();
    };

    window.saveInlineEditRoster = async (rowKey, type) => {
      const idInput = document.getElementById(`inlineId_${rowKey}`);
      const nameInput = document.getElementById(`inlineName_${rowKey}`);
      if (!idInput || !nameInput) return;
      const newIdNumber = idInput.value.trim();
      const newName = nameInput.value.trim();

      if (!newIdNumber || !newName) {
        alert("Fields cannot be empty.");
        return;
      }

      if (type === 'leadership') {
        const parts = rowKey.split('__');
        const catKey = parts[1];
        const memId = parts[2];
        const mem = window.state.leadership[catKey]?.find(m => m.id === memId);
        if (mem) {
          mem.idNumber = newIdNumber;
          mem.name = newName;
        }
      } else if (type === 'tl') {
        const team = window.state.teams.find(t => t.id === rowKey);
        if (team) {
          team.idNumber = newIdNumber;
          team.name = newName;
        }
      } else if (type === 'subordinate') {
        const parts = rowKey.split('__');
        const teamId = parts[0];
        const oldSubIdNumber = parts[1];
        const team = window.state.teams.find(t => t.id === teamId);
        if (team) {
          const sub = team.subordinates.find(s => s.idNumber === oldSubIdNumber);
          if (sub) {
            sub.idNumber = newIdNumber;
            sub.name = newName;
          }
        }
      }

      window.state.editingRowKey = null;
      await window.saveRosterToFirestore();
      window.updateTeamDropdownUI();
      window.renderRosterTable();
      window.renderDashboard();
    };

    window.deleteLeadershipRecord = async (catKey, memId) => {
      window.openDeleteConfirmModal("Are you sure you want to delete this leadership record?", async () => {
        window.state.leadership[catKey] = window.state.leadership[catKey].filter(m => m.id !== memId);
        await window.saveRosterToFirestore();
        window.renderRosterTable();
        window.renderDashboard();
      });
    };

    window.deleteTeamLeaderRecord = async (teamId) => {
      window.openDeleteConfirmModal("Are you sure you want to delete this Team Leader and their subordinates?", async () => {
        window.state.teams = window.state.teams.filter(t => t.id !== teamId);
        if (window.state.selectedTeamId === teamId && window.state.teams.length > 0) {
          window.state.selectedTeamId = window.state.teams[0].id;
        }
        await window.saveRosterToFirestore();
        window.updateTeamDropdownUI();
        window.renderRosterTable();
        window.renderDashboard();
      });
    };

    window.deleteSubordinateUser = async (teamId, subIdNumber) => {
      window.openDeleteConfirmModal("Are you sure you want to delete this subordinate?", async () => {
        const team = window.state.teams.find(t => t.id === teamId);
        if (team) {
          team.subordinates = team.subordinates.filter(s => s.idNumber !== subIdNumber);
          await window.saveRosterToFirestore();
          window.renderRosterTable();
          window.renderDashboard();
        }
      });
    };

    window.openDeleteConfirmModal = (text, onConfirmCallback) => {
      document.getElementById('deleteConfirmText').textContent = text;
      window.state.pendingDeleteAction = onConfirmCallback;
      document.getElementById('deleteConfirmModal').classList.remove('hidden');
    };

    window.closeDeleteConfirmModal = (e) => {
      if (e && e.target !== e.currentTarget) return;
      window.state.pendingDeleteAction = null;
      document.getElementById('deleteConfirmModal').classList.add('hidden');
    };

    window.executePendingDelete = async () => {
      const cb = window.state.pendingDeleteAction;
      if (cb) await cb();
      window.closeDeleteConfirmModal();
    };

    window.handleAddTeamOrStaffSubmit = async (e) => {
      e.preventDefault();
      const type = document.getElementById('newAddType').value;
      const idNumber = document.getElementById('newLeaderId').value.trim();
      const name = document.getElementById('newLeaderName').value.trim();

      if (!idNumber || !name) return;

      if (type === 'subordinate') {
        const targetTLId = document.getElementById('assignToTL').value;
        const team = window.state.teams.find(t => t.id === targetTLId);
        if (team) {
          team.subordinates.push({ idNumber, name });
        }
      } else if (type === 'teamLeader') {
        const newTeamId = `tl_${name.toLowerCase().replace(/[^a-z0-9]/g, '_')}_${Date.now()}`;
        window.state.teams.push({
          id: newTeamId,
          name: name,
          idNumber: idNumber,
          role: 'Team Leader',
          subordinates: []
        });
      } else if (type === 'leadership') {
        const roleKey = document.getElementById('newLeadRoleKey').value;
        if (!window.state.leadership[roleKey]) window.state.leadership[roleKey] = [];
        window.state.leadership[roleKey].push({
          id: `${roleKey}_${Date.now()}`,
          name: name,
          idNumber: idNumber
        });
      }

      document.getElementById('newLeaderId').value = '';
      document.getElementById('newLeaderName').value = '';

      await window.saveRosterToFirestore();
      window.updateTeamDropdownUI();
      window.populateTLSelectForAdmin();
      window.renderRosterTable();
      window.renderDashboard();
      alert("Successfully added new record!");
    };

    window.onload = async () => {
      await bootstrapFirestoreData();
      window.applyTheme();
      window.openLoginModal();
    };
	
  </script>



