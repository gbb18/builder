window.renderWardenLedger = () => {
  const dateVal = document.getElementById('wardenLedgerDate').value || window.state.selectedDate || getLocalDateString();
  const statusFilter = document.getElementById('wardenLedgerStatusFilter').value || 'ALL';
  const logs = window.state.dailyLogs[dateVal] || {};
  const tbody = document.getElementById('wardenLedgerTableBody');
  const cardsContainer = document.getElementById('wardenSummaryCards');
  if (!tbody) return;

  // Compute status totals
  let counts = {
    'Present': 0,
    'On Leave': 0,
    'On Training CPO': 0,
    'Late': 0,
    'Undertime': 0,
    'Absent': 0
  };

  const allRecords = [];

  window.state.teams.forEach(team => {
    team.subordinates.forEach(sub => {
      const log = logs[sub.idNumber] || { status: 'Present', note: '' };
      const status = log.status || 'Present';
      
      if (counts[status] !== undefined) {
        counts[status]++;
      } else {
        counts['Present']++;
      }

      allRecords.push({
        teamName: team.name,
        name: sub.name,
        idNumber: sub.idNumber,
        status: status,
        note: log.note || ''
      });
    });
  });

  // Render Interactive Summary Cards
  if (cardsContainer) {
    const statuses = [
      { key: 'Present', label: 'Present', color: 'emerald', icon: 'fa-user-check' },
      { key: 'Late', label: 'Late', color: 'amber', icon: 'fa-clock' },
      { key: 'Undertime', label: 'Undertime', color: 'teal', icon: 'fa-business-time' },
      { key: 'On Leave', label: 'On Leave', color: 'indigo', icon: 'fa-umbrella-beach' },
      { key: 'On Training CPO', label: 'Training (CPO)', color: 'purple', icon: 'fa-graduation-cap' },
      { key: 'Absent', label: 'Absent', color: 'rose', icon: 'fa-user-xmark' }
    ];

    cardsContainer.innerHTML = '';
    statuses.forEach(s => {
      const count = counts[s.key] || 0;
      const isSelected = statusFilter === s.key;
      const ringClass = isSelected ? `ring-2 ring-${s.color}-500 shadow-md scale-[1.02]` : '';
      
      cardsContainer.innerHTML += `
        <div onclick="filterWardenLedgerByStatus('${s.key}')" class="glass-panel p-2.5 rounded-xl cursor-pointer hover:scale-[1.02] transition transform border border-${s.color}-500/30 bg-${s.color}-500/10 ${ringClass} flex flex-col justify-between">
