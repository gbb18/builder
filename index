          <i class="fa-solid fa-clipboard-list text-emerald-500"></i> Summary & Remarks Note
        </label>
        <textarea id="scSummaryRemarksInput" rows="2" placeholder="Enter daily summary notes or remarks for screenshot review..." oninput="syncSummaryRemarks(this.value)" class="w-full dynamic-input border text-xs rounded-xl p-2.5 focus:ring-2 focus:ring-emerald-500 focus:outline-none"></textarea>
      </div>
    </div>
  </section>

  <!-- Main Content Container -->
