};

function updatePinDots() {
  const inputVal = document.getElementById('pinInputBuffer').value;
  const dots = document.querySelectorAll('.pin-dot');
  
  dots.forEach((dot, index) => {
    if (index < inputVal.length) {
      dot.classList.add('bg-white', 'border-white', 'shadow-[0_0_10px_rgba(255,255,255,0.8)]');
    } else {
      dot.classList.remove('bg-white', 'border-white', 'shadow-[0_0_10px_rgba(255,255,255,0.8)]');
    }
  });
}

window.appendPinKeypad = (num) => {
  const input = document.getElementById('pinInputBuffer');
  const errorDiv = document.getElementById('pinChangeError');
  errorDiv.classList.add('hidden');

  if (input && input.value.length < 4) {
    input.value += num;
    updatePinDots();

    if (input.value.length === 4) {
      setTimeout(() => {
        handlePinStepCompletion(input.value);
      }, 200);
    }
  }
};

window.clearPinKeypad = () => {
  const input = document.getElementById('pinInputBuffer');
  if (input) {
    input.value = '';
    updatePinDots();
  }
};

window.backspacePinKeypad = () => {
  const input = document.getElementById('pinInputBuffer');
  if (input) {
    input.value = input.value.slice(0, -1);
    updatePinDots();
  }
};

function handlePinStepCompletion(enteredValue) {
  const input = document.getElementById('pinInputBuffer');
  const title = document.getElementById('pinStepTitle');
  const subtitle = document.getElementById('pinStepSubtitle');
  const icon = document.getElementById('pinStepIcon');
  const errorDiv = document.getElementById('pinChangeError');

  if (pinChangeState.step === 1) {
    // Step 1: Captured Old PIN
    pinChangeState.oldPin = enteredValue;
    input.value = '';
    updatePinDots();
    
    // Move to Step 2
    pinChangeState.step = 2;
    title.innerText = 'Enter New PIN';
    subtitle.innerText = 'Step 2 of 3';
    icon.className = 'fa-solid fa-lock-open text-xl text-teal-400';

  } else if (pinChangeState.step === 2) {
    // Step 2: Captured New PIN
    pinChangeState.newPin = enteredValue;
    input.value = '';
    updatePinDots();

    // Move to Step 3
    pinChangeState.step = 3;
    title.innerText = 'Confirm New PIN';
    subtitle.innerText = 'Step 3 of 3';
    icon.className = 'fa-solid fa-shield-check text-xl text-emerald-400';

  } else if (pinChangeState.step === 3) {
    // Step 3: Captured Confirmation PIN
    pinChangeState.confirmPin = enteredValue;

    if (pinChangeState.newPin !== pinChangeState.confirmPin) {
      errorDiv.innerText = 'New PINs do not match! Starting over.';
      errorDiv.classList.remove('hidden');
      setTimeout(() => {
        resetPinWorkflow();
      }, 1500);
      return;
    }

    // SUCCESS: Send pinChangeState.oldPin and pinChangeState.newPin to your backend/Firebase update logic here
    triggerBackendPinUpdate(pinChangeState.oldPin, pinChangeState.newPin);
  }
}

function resetPinWorkflow() {
  pinChangeState = { step: 1, oldPin: '', newPin: '', confirmPin: '' };
  document.getElementById('pinInputBuffer').value = '';
  document.getElementById('pinStepTitle').innerText = 'Enter Current PIN';
  document.getElementById('pinStepSubtitle').innerText = 'Step 1 of 3';
  document.getElementById('pinStepIcon').className = 'fa-solid fa-key text-xl text-emerald-400';
  document.getElementById('pinChangeError').classList.add('hidden');
  updatePinDots();
}

