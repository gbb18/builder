<!DOCTYPE html>
<html lang="en" class="h-full transition-colors duration-300 light" id="htmlTag">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>Attendance Monitor - Secure Dashboard</title>
  
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- FontAwesome Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <!-- Chart.js CDN -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <!-- Google Fonts: Inter -->
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">

  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          fontFamily: { sans: ['Inter', 'sans-serif'] },
          colors: {
            brand: {
              50: '#f0fdf4',
              500: '#22c55e',
              600: '#16a34a',
              700: '#15803d',
              900: '#14532d'
            }
          }
        }
      }
    }
  </script>

  <style>
    * { -webkit-tap-highlight-color: transparent; }
    ::-webkit-scrollbar { width: 6px; height: 6px; }
    ::-webkit-scrollbar-track { background: var(--bg-scroll-track, #0f172a); }
    ::-webkit-scrollbar-thumb { background: var(--bg-scroll-thumb, #475569); border-radius: 4px; }
    
    :root, .dark {
      --bg-main: #0b1120;
      --text-main: #f8fafc;
      --glass-bg: rgba(30, 41, 59, 0.95);
      --glass-border: rgba(255, 255, 255, 0.16);
      --modal-bg: rgba(15, 23, 42, 0.98);
      --modal-border: rgba(255, 255, 255, 0.2);
      --card-inner-bg: rgba(30, 41, 59, 0.9);
      --input-bg: #1e293b;
      --input-border: #475569;
      --subtext: #cbd5e1;
      --heading-text: #ffffff;
      --bg-scroll-track: #0f172a;
      --bg-scroll-thumb: #475569;
    }

    .light {
      --bg-main: #f1f5f9;
      --text-main: #0f172a;
      --glass-bg: rgba(255, 255, 255, 0.98);
      --glass-border: rgba(203, 213, 225, 0.9);
      --modal-bg: rgba(255, 255, 255, 0.99);
      --modal-border: rgba(203, 213, 225, 0.9);
      --card-inner-bg: #ffffff;
      --input-bg: #ffffff;
      --input-border: #cbd5e1;
      --subtext: #334155;
      --heading-text: #0f172a;
      --bg-scroll-track: #e2e8f0;
      --bg-scroll-thumb: #64748b;
    }

    body { background-color: var(--bg-main); color: var(--text-main); transition: background-color 0.3s ease, color 0.3s ease; }
    .glass-panel { background: var(--glass-bg); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); border: 1px solid var(--glass-border); box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06); }
    .glass-modal { background: var(--modal-bg); backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); border: 1px solid var(--modal-border); color: var(--text-main); }
    .dynamic-input { background-color: var(--input-bg); border-color: var(--input-border); color: var(--text-main); font-weight: 500; }
    .dynamic-subtext { color: var(--subtext); }
    .dynamic-heading { color: var(--heading-text); }
  
    .footer-gbb { text-align: center; padding: 1.5rem; font-size: 0.75rem; font-weight: 600; opacity: 0.85; margin-top: auto; }
    .footer-gbb span { color: #f43f5e; display: inline-block; animation: pulse 2s infinite; }
  
     button, input, .glass-modal {
     touch-action: manipulation;
 }


</style>
</head>
<body class="h-full flex flex-col font-sans antialiased selection:bg-emerald-500 selection:text-white">

  <!-- Clean Top Navigation Header -->
<header id="mainHeader" class="sticky top-0 z-35 glass-panel border-b border-slate-300 dark:border-slate-700/80 px-3 sm:px-6 py-3 shadow-md backdrop-blur-md bg-white/80 dark:bg-slate-900/80 transition-colors">
  <div class="max-w-7xl mx-auto flex flex-col lg:flex-row items-center justify-between gap-3 lg:gap-4">
      
