          </div>
          <div class="text-base font-black text-${s.color}-600 dark:text-${s.color}-300 mt-1">${count}</div>
        </div>
      `;
    });
  }

  // Render Table Records based on Filter
  tbody.innerHTML = '';
  const filteredRecords = allRecords.filter(r => statusFilter === 'ALL' || r.status === statusFilter);

  if (filteredRecords.length === 0) {
    tbody.innerHTML = `
      <tr>
        <td colspan="4" class="p-8 text-center dynamic-subtext font-semibold">No records found for the selected status filter.</td>
      </tr>
    `;
    return;
  }

  filteredRecords.forEach(r => {
    let badgeClass = 'bg-slate-500/20 text-slate-700 dark:text-slate-300 border-slate-500/40';
    if (r.status === 'Present') badgeClass = 'bg-emerald-500/20 text-emerald-700 dark:text-emerald-300 border-emerald-500/40';
    else if (r.status === 'Late') badgeClass = 'bg-amber-500/20 text-amber-700 dark:text-amber-300 border-amber-500/40';
