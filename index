// Global or module-level registry for active unsubscriptions
const activeListeners = {
  attendance: null,
  claims: null,
  roster: null
};

function registerListener(key, unsubscribeFn) {
  //If a listener already exists for this key, clean it up first
  if (activeListeners[key]) {
    activeListeners[key]();
  }
  activeListeners[key] = unsubscribeFn;
}

function cleanupListener(key) {
  if (activeListeners[key]) {
    activeListeners[key]();
    activeListeners[key] = null;
  }
}

function cleanupAllListeners() {
  Object.keys(activeListeners).forEach(key => {
    cleanupListener(key);
  });
}




